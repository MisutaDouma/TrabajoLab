package ar.edu.lab.domain;

import ar.edu.lab.repositorio.Repositorio;

public class Reserva {
    public Cliente cliente;
    public Vehiculo vehiculo;
    private Repositorio<Vehiculo> vehiculos = new Repositorio<>();
    public int dias;

    public Reserva(Cliente cliente, Vehiculo vehiculo, int dias){
        this.cliente= cliente;
        this.vehiculo= vehiculo;
        this.dias = dias;
    }

    public Reserva(Cliente cliente, Repositorio<Vehiculo> vehiculos, int dias){
        this.cliente = cliente;
        this.vehiculos = vehiculos;
        this.dias = dias;
    }

    public Cliente getCliente() {
        return cliente;
    }

    public Vehiculo getVehiculo() {
        return vehiculo;
    }

    public int getDias() {
        return dias;
    }
    
    public void mostrarReserva(){
        System.out.println("=== RESERVAS DE VEHICULOS===\n");

        System.out.println("Cliente: "
            + cliente.getNombre()
            + " DNI: "
            + cliente.getDNI()
        );

        if(this.vehiculos.size() > 0){
            for(Vehiculo v: this.vehiculos.obtenerTodos()){
                System.out.println(v.mostrarDetalles());
                System.out.println("Precio de reserva: "
                    + v.calcularPrecio(this.dias));
            }
        }
    }

    public Repositorio<Vehiculo> getVehiculos(){
        return vehiculos;
    }

    public void setVehiculos(Repositorio<Vehiculo> vehiculos){
        this.vehiculos = vehiculos;
    }
}
