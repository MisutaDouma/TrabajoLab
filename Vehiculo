package ar.edu.lab.domain;

public abstract class Vehiculo implements Alquilable{
    protected String marca;
    protected String modelo;
    protected double precioPorDia;

    public Vehiculo(String marca, String modelo, double precioPorDia){
        this.marca= marca;
        this.modelo= modelo;
        this.precioPorDia= precioPorDia;
    }

    public String mostrarDetalles(){
        return "Marca: "+ marca+ " Modelo: "+ modelo+ " PrecioPorDia: "+precioPorDia;
    }

    @Override
    public double calcularPrecio(double dias) {
        return precioPorDia * dias;
    }
    

    public String getMarca() {
        return marca;
    }

    public String getModelo() {
        return modelo;
    }

    public double getPrecioPorDia() {
        return precioPorDia;
    }

    public void setPrecioPorDia(double precioPorDia) {
        this.precioPorDia = precioPorDia;
    };

    

}
